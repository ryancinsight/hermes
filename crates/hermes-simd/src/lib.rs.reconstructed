/// Generate Rook attacks for a square given occupancy using the Magic bitboard backend.
#[inline(always)]
pub fn rook_attacks(square: u8, occupancy: u64) -> u64 {
    unsafe { <Magic as BitBoardKernel>::rook_attacks(square, occupancy) }
}

/// Generate Bishop attacks for a square given occupancy using the Magic bitboard backend.
#[inline(always)]
pub fn bishop_attacks(square: u8, occupancy: u64) -> u64 {
    unsafe { <Magic as BitBoardKernel>::bishop_attacks(square, occupancy) }
}

/// Generate Queen attacks for a square given occupancy using the Magic bitboard backend.
#[inline(always)]
pub fn queen_attacks(square: u8, occupancy: u64) -> u64 {
    rook_attacks(square, occupancy) | bishop_attacks(square, occupancy)
}

/// Returns true if the current CPU supports Intel AMX BF16 matrix multiplication.
#[inline]
pub fn has_amx_bf16() -> bool {
    #[cfg(target_arch = "x86_64")]
    {
        let res = core::arch::x86_64::__cpuid_count(7, 0);
        let amx_tile = (res.edx & (1 << 24)) != 0;
        let amx_bf16 = (res.edx & (1 << 22)) != 0;
        amx_tile && amx_bf16
    }
    #[cfg(not(target_arch = "x86_64"))]
    {
        false
    }
}

/// Returns true if the current CPU supports Intel AMX INT8 matrix multiplication.
#[inline]
pub fn has_amx_int8() -> bool {
    #[cfg(target_arch = "x86_64")]
    {
        let res = core::arch::x86_64::__cpuid_count(7, 0);
        let amx_tile = (res.edx & (1 << 24)) != 0;
        let amx_int8 = (res.edx & (1 << 25)) != 0;
        amx_tile && amx_int8
    }
    #[cfg(not(target_arch = "x86_64"))]
    {
        false
    }
}

/// Returns true if the current CPU supports AVX-512 VNNI.
#[inline]
pub fn has_avx512vnni() -> bool {
    #[cfg(target_arch = "x86_64")]
    {
        let res = core::arch::x86_64::__cpuid_count(7, 0);
        (res.ecx & (1 << 11)) != 0
    }
    #[cfg(not(target_arch = "x86_64"))]
    {
        false
    }
}

/// Returns true if the current CPU supports AVX-512 BF16.
#[inline]
pub fn has_avx512bf16() -> bool {
    #[cfg(target_arch = "x86_64")]
    {
        let res = core::arch::x86_64::__cpuid_count(7, 1);
        (res.eax & (1 << 5)) != 0
    }
    #[cfg(not(target_arch = "x86_64"))]
    {
        false
    }
}

